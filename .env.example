# Copy to .env, then: chmod 600 .env. Placeholders only; real values never go in git.
# Pick the model: off (offline rules, no key needed) | anthropic | openai | claude (claude CLI login) | qwen (local)
SEBASTIAN_NL=anthropic
# Nothing is sent to a model provider until you set this to 1.
SEBASTIAN_NL_CONSENT=0
# Your own key for the provider you chose (only that one is read).
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
# Optional: model name override
# SEBASTIAN_NL_MODEL=
# Your chat id on the configured channel (Telegram: message @userinfobot).
SEBASTIAN_OWNER_CHAT_ID=your-chat-id-here
