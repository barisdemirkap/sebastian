# Copy to ~/.config/sebastian/env and chmod 600. KEY=VALUE lines, no export, no quotes needed.
# The Telegram token is NOT here: it stays in ~/.config/sebastian/secrets/telegram.token (read at runtime only).
SEBASTIAN_OWNER_CHAT_ID=your-telegram-chat-id
# Live gates (owner decisions). Keep both off until OAuth is done and you have tried `sebastian chat` and `sebastian demo`.
SEBASTIAN_ALLOW_LIVE=1
SEBASTIAN_ALLOW_WRITE=1
# Natural language: claude (one-shot `claude -p`) with local Qwen as fallback. CONSENT=1 means you agree that your
# messages and your next-14-days event titles are sent to the model provider.
SEBASTIAN_NL=claude
SEBASTIAN_NL_CONSENT=1
SEBASTIAN_NL_DAILY_CAP=60
# Agent mode pilot (ADR 0019): set SEBASTIAN_NL=agent above (needs CONSENT=1). Rollback: SEBASTIAN_NL=claude, or /ajan kapat in the chat.
# SEBASTIAN_AGENT_MODEL=sonnet
# SEBASTIAN_AGENT_DAILY_CAP=80
# SEBASTIAN_AGENT_MAX_TURNS=40
# Claude Code keeps session transcripts for cleanupPeriodDays (default 30); consider a shorter period in your user settings.
# Voice (optional, fully local: ffmpeg + whisper-cli + say Yelda)
# SEBASTIAN_VOICE=1
# SEBASTIAN_WHISPER_MODEL=/Users/you/models/ggml-small.bin
